<?xml version="1.0" encoding="utf-8"?>
<!--
    Android backup is off: the encrypted backup in Settings is the supported way to move data.
    App data can't be restored usefully elsewhere because Keystore keys never leave the device,
    so a restored TLS keystore or secure preference file would be unreadable.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
